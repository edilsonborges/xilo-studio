{
  "name": "xilo-studio",
  "version": "0.8.0",
  "private": true,
  "description": "Roteiro + narração → vídeo vertical 3D low-poly com cel-shading, legendas karaokê e exportação automática. Three.js + LLM.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node --import tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "tsx --test server/*.test.ts src/*.test.ts src/**/*.test.ts",
    "check": "npm run test && npm run build",
    "narrar": "node --import tsx scripts/narrar.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "msedge-tts": "^2.1.1",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true,
    "msedge-tts": false,
    "fsevents": false
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
