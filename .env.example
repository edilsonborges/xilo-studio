# Copie para .env (nunca vai para o Git) e preencha.

# ---- Servidor de contas (login, convites e senhas) ----

# E-mails dos administradores, separados por vírgula. Eles gerenciam os usuários
# em /admin e criam a própria senha em "Esqueci minha senha / primeiro acesso".
ADMIN_EMAILS=

# Chave da API do Resend (https://resend.com/api-keys), com permissão de envio.
# Sem ela o login funciona, mas convites e "esqueci a senha" ficam desligados.
RESEND_API_KEY=

# Remetente; o domínio precisa estar verificado no Resend.
RESEND_FROM="Xilo Studio <acesso@edilson.dev>"

# Só para desenvolvimento local (o docker-compose.yml já define os de produção).
# APP_ORIGIN=http://localhost:5173
# DATABASE_PATH=./data/xilo.sqlite

# ---- App no navegador ----
# As chaves de IA (OpenAI, Gemini, Anthropic) NÃO vêm deste arquivo: são digitadas
# na tela de Configurações do app e ficam só no localStorage do navegador.
# As variáveis abaixo são opcionais e não são segredos: só trocam os modelos
# padrão sugeridos na tela de Configurações.

VITE_OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_TRANSCRIBE_MODEL=whisper-1
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_ANTHROPIC_MODEL=claude-opus-5-5
