# Xilo Studio roda 100% no navegador e NÃO lê chaves de API deste arquivo.
# As chaves (OpenAI, Gemini, Anthropic) são digitadas na tela de Configurações
# do app e ficam apenas no localStorage do seu navegador.
#
# As variáveis abaixo são opcionais e não são segredos: só trocam os modelos
# padrão sugeridos na tela de Configurações. Copie para .env se quiser mudar.

VITE_OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_TRANSCRIBE_MODEL=whisper-1
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_ANTHROPIC_MODEL=claude-opus-5-5
